{
  "id": "WaHg39lgqwBWAUl1",
  "name": "Telegram adapter",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "telegram", "responseMode": "onReceived", "options": {} },
      "name": "Telegram webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "telegram-adapter"
    },
    {
      "parameters": {
        "jsCode": "// Telegram-specific parsing lives only here: text messages and button presses become one neutral shape.\nconst { headers, body } = $input.first().json;\nconst cb = body.callback_query;\nconst msg = cb ? cb.message : body.message;\nconst from = cb ? cb.from : body.message?.from;\nconst text = cb ? undefined : body.message?.text;\nconst action = cb ? cb.data : undefined;\nconst authentic = headers['x-telegram-bot-api-secret-token'] === $env.TELEGRAM_WEBHOOK_SECRET;\nreturn [{ json: {\n  valid: authentic && !!msg && !!from && (!!text || !!action),\n  chatId: msg?.chat?.id,\n  userId: String(from?.id),\n  name: from?.first_name,\n  text,\n  action,\n  callbackId: cb?.id ?? '',\n} }];"
      },
      "name": "Normalize update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "valid",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Authentic and supported?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "is-callback",
              "leftValue": "={{ $json.callbackId }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Button press?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [660, 120]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/answerCallbackQuery",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ callback_query_id: $json.callbackId }) }}",
        "options": {}
      },
      "name": "Stop button spinner",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 60]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AGENT_URL }}/message",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "x-agent-key", "value": "={{ $env.AGENT_API_KEY }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ channel: 'telegram', channelUserId: $json.userId, name: $json.name, text: $json.text, action: $json.action }) }}",
        "options": { "timeout": 90000 }
      },
      "name": "Ask agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, -100]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "has-reply",
              "leftValue": "={{ $json.reply }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Agent replied?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [880, -100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $('Normalize update').item.json.chatId, text: $json.reply, reply_markup: $json.buttons ? { inline_keyboard: $json.buttons.map(r => r.map(b => ({ text: b.label, callback_data: b.data }))) } : undefined }) }}",
        "options": {}
      },
      "name": "Send to Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, -200]
    }
  ],
  "connections": {
    "Telegram webhook": { "main": [[{ "node": "Normalize update", "type": "main", "index": 0 }]] },
    "Normalize update": { "main": [[{ "node": "Authentic and supported?", "type": "main", "index": 0 }]] },
    "Authentic and supported?": {
      "main": [
        [{ "node": "Ask agent", "type": "main", "index": 0 }, { "node": "Button press?", "type": "main", "index": 0 }],
        []
      ]
    },
    "Button press?": { "main": [[{ "node": "Stop button spinner", "type": "main", "index": 0 }], []] },
    "Ask agent": { "main": [[{ "node": "Agent replied?", "type": "main", "index": 0 }]] },
    "Agent replied?": { "main": [[{ "node": "Send to Telegram", "type": "main", "index": 0 }], []] }
  },
  "settings": { "executionOrder": "v1" }
}
