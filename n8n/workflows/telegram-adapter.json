{
  "name": "Telegram adapter",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "telegram", "responseMode": "onReceived", "options": {} },
      "name": "Telegram webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "telegram-adapter"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "secret",
              "leftValue": "={{ $json.headers['x-telegram-bot-api-secret-token'] }}",
              "rightValue": "={{ $env.TELEGRAM_WEBHOOK_SECRET }}",
              "operator": { "type": "string", "operation": "equals" }
            },
            {
              "id": "has-text",
              "leftValue": "={{ $json.body.message?.text }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Authentic text message?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AGENT_URL }}/message",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "x-agent-key", "value": "={{ $env.AGENT_API_KEY }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ channel: 'telegram', channelUserId: String($('Telegram webhook').item.json.body.message.from.id), name: $('Telegram webhook').item.json.body.message.from.first_name, text: $('Telegram webhook').item.json.body.message.text }) }}",
        "options": { "timeout": 90000 }
      },
      "name": "Ask agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, -100]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "has-reply",
              "leftValue": "={{ $json.reply }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Agent replied?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [660, -100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $('Telegram webhook').item.json.body.message.chat.id, text: $json.reply }) }}",
        "options": {}
      },
      "name": "Send to Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, -200]
    }
  ],
  "connections": {
    "Telegram webhook": { "main": [[{ "node": "Authentic text message?", "type": "main", "index": 0 }]] },
    "Authentic text message?": { "main": [[{ "node": "Ask agent", "type": "main", "index": 0 }], []] },
    "Ask agent": { "main": [[{ "node": "Agent replied?", "type": "main", "index": 0 }]] },
    "Agent replied?": { "main": [[{ "node": "Send to Telegram", "type": "main", "index": 0 }], []] }
  },
  "settings": { "executionOrder": "v1" }
}
