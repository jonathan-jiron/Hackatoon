{
  "id": "OpSendWorkflow01",
  "name": "Operator send",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "operator-send", "responseMode": "responseNode", "options": {} },
      "name": "Operator webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "operator-send"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "key",
              "leftValue": "={{ $json.headers['x-operator-key'] }}",
              "rightValue": "={{ $env.OPERATOR_SEND_KEY }}",
              "operator": { "type": "string", "operation": "equals" }
            },
            {
              "id": "channel",
              "leftValue": "={{ $json.body.channel }}",
              "rightValue": "telegram",
              "operator": { "type": "string", "operation": "equals" }
            },
            {
              "id": "text",
              "leftValue": "={{ $json.body.text }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Authorized telegram message?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $json.body.channel_user_id, text: $json.body.text }) }}",
        "options": {}
      },
      "name": "Send to Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, -80]
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={{ JSON.stringify({ ok: true }) }}", "options": {} },
      "name": "Respond ok",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [660, -80]
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={{ JSON.stringify({ ok: false }) }}", "options": { "responseCode": 403 } },
      "name": "Respond forbidden",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [440, 100]
    }
  ],
  "connections": {
    "Operator webhook": { "main": [[{ "node": "Authorized telegram message?", "type": "main", "index": 0 }]] },
    "Authorized telegram message?": {
      "main": [
        [{ "node": "Send to Telegram", "type": "main", "index": 0 }],
        [{ "node": "Respond forbidden", "type": "main", "index": 0 }]
      ]
    },
    "Send to Telegram": { "main": [[{ "node": "Respond ok", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
