# Copy to .env.local. Leave DATABASE_URL empty to run in demo mode with fake data.
# Same database that `docker compose up -d db` starts.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/ctt

# Optional. n8n webhook that only DELIVERS the operator text through the Telegram Bot API.
# The dashboard stores the message itself.
# Body: { conversation_id, channel, channel_user_id, text }
N8N_SEND_WEBHOOK_URL=
